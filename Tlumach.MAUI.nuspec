<?xml version="1.0" encoding="utf-8"?>
<!-- The $version$ and $commit$ tokens are set by the build script (nuget pack -Properties "version=...;commit=..."), see build-tlumach-net.cmd -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AlliedBits.Tlumach.MAUI</id>
        <version>$version$</version>
        <authors>Allied Bits Ltd., Eugene Mayevski</authors>
        <copyright>Allied Bits Ltd.</copyright>
        <license type="expression">Apache-2.0</license>
        <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
        <icon>Tlumach.png</icon>
        <title>.NET MAUI integration for Tlumach, the translation and localization package for .NET</title>
        <tags>tlumach translation localization maui xaml</tags>
        <repository type="git" url="https://github.com/Allied-Bits-Ltd/tlumach-net" commit="$commit$" />
        <projectUrl>https://alliedbits.com/tlumach</projectUrl>
        <readme>README.maui.nuget.md</readme>
        <description>
            This package integrates Tlumach.NET with .NET MAUI: the markup extension and the bindings that show translations in XAML and update the UI when the language is switched.
        </description>
        <dependencies>
            <!-- The dependency on AlliedBits.Tlumach does not exclude analyzers, so that the generator reaches the projects that reference only this package -->
            <group targetFramework="net9.0-android21.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Maui.Controls" version="9.0.0" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net9.0-ios15.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Maui.Controls" version="9.0.0" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net9.0-maccatalyst15.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Maui.Controls" version="9.0.0" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net9.0-windows10.0.19041.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Maui.Controls" version="9.0.0" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net10.0-android21.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Maui.Controls" version="10.0.0" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net10.0-ios15.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Maui.Controls" version="10.0.0" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net10.0-maccatalyst15.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Maui.Controls" version="10.0.0" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net10.0-windows10.0.19041.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Maui.Controls" version="10.0.0" exclude="Build,Analyzers" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="README.maui.nuget.md" target="\" />
        <file src="Tlumach.png" target="\" />

        <!-- net9.0-android21.0 -->
        <file src="src\Tlumach.MAUI\bin\Release\net9.0-android\Tlumach.MAUI.dll" target="lib\net9.0-android21.0" />
        <file src="src\Tlumach.MAUI\bin\Release\net9.0-android\Tlumach.MAUI.xml" target="lib\net9.0-android21.0" />

        <!-- net9.0-ios15.0 -->
        <file src="src\Tlumach.MAUI\bin\Release\net9.0-ios\Tlumach.MAUI.dll" target="lib\net9.0-ios15.0" />
        <file src="src\Tlumach.MAUI\bin\Release\net9.0-ios\Tlumach.MAUI.xml" target="lib\net9.0-ios15.0" />

        <!-- net9.0-maccatalyst15.0 -->
        <file src="src\Tlumach.MAUI\bin\Release\net9.0-maccatalyst\Tlumach.MAUI.dll" target="lib\net9.0-maccatalyst15.0" />
        <file src="src\Tlumach.MAUI\bin\Release\net9.0-maccatalyst\Tlumach.MAUI.xml" target="lib\net9.0-maccatalyst15.0" />

        <!-- net9.0-windows10.0.19041.0 -->
        <file src="src\Tlumach.MAUI\bin\Release\net9.0-windows10.0.19041.0\Tlumach.MAUI.dll" target="lib\net9.0-windows10.0.19041.0" />
        <file src="src\Tlumach.MAUI\bin\Release\net9.0-windows10.0.19041.0\Tlumach.MAUI.xml" target="lib\net9.0-windows10.0.19041.0" />

        <!-- net10.0-android21.0 -->
        <file src="src\Tlumach.MAUI\bin\Release\net10.0-android\Tlumach.MAUI.dll" target="lib\net10.0-android21.0" />
        <file src="src\Tlumach.MAUI\bin\Release\net10.0-android\Tlumach.MAUI.xml" target="lib\net10.0-android21.0" />

        <!-- net10.0-ios15.0 -->
        <file src="src\Tlumach.MAUI\bin\Release\net10.0-ios\Tlumach.MAUI.dll" target="lib\net10.0-ios15.0" />
        <file src="src\Tlumach.MAUI\bin\Release\net10.0-ios\Tlumach.MAUI.xml" target="lib\net10.0-ios15.0" />

        <!-- net10.0-maccatalyst15.0 -->
        <file src="src\Tlumach.MAUI\bin\Release\net10.0-maccatalyst\Tlumach.MAUI.dll" target="lib\net10.0-maccatalyst15.0" />
        <file src="src\Tlumach.MAUI\bin\Release\net10.0-maccatalyst\Tlumach.MAUI.xml" target="lib\net10.0-maccatalyst15.0" />

        <!-- net10.0-windows10.0.19041.0 -->
        <file src="src\Tlumach.MAUI\bin\Release\net10.0-windows10.0.19041.0\Tlumach.MAUI.dll" target="lib\net10.0-windows10.0.19041.0" />
        <file src="src\Tlumach.MAUI\bin\Release\net10.0-windows10.0.19041.0\Tlumach.MAUI.xml" target="lib\net10.0-windows10.0.19041.0" />
    </files>
</package>
