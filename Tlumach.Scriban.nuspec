<?xml version="1.0" encoding="utf-8"?>
<!-- The $version$ and $commit$ tokens are set by the build script (nuget pack -Properties "version=...;commit=..."), see build-tlumach-net.cmd -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AlliedBits.Tlumach.Scriban</id>
        <version>$version$</version>
        <authors>Allied Bits Ltd., Eugene Mayevski</authors>
        <copyright>Allied Bits Ltd.</copyright>
        <license type="expression">Apache-2.0</license>
        <icon>Tlumach.png</icon>
        <title>Scriban integration for Tlumach, the translation and localization package for .NET</title>
        <tags>tlumach translation localization scriban template email</tags>
        <repository type="git" url="https://github.com/Allied-Bits-Ltd/tlumach-net" commit="$commit$" />
        <projectUrl>https://alliedbits.com/tlumach</projectUrl>
        <readme>README.scriban.nuget.md</readme>
        <releaseNotes>https://github.com/Allied-Bits-Ltd/tlumach-net/blob/v$version$/CHANGELOG.md</releaseNotes>
        <description>
            This package lets Scriban templates (emails, reports, documents) use Tlumach.NET translations through the `t` and `t_html` functions, with named, indexed and ICU placeholder values and a culture per render, so that many cultures can be rendered concurrently.
        </description>
        <dependencies>
            <!-- The dependency on AlliedBits.Tlumach does not exclude analyzers, so that the generator reaches the projects that reference only this package -->
            <group targetFramework="net9.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Scriban" version="[7.2.2, 8.0.0)" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net10.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Scriban" version="[7.2.2, 8.0.0)" exclude="Build,Analyzers" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="README.scriban.nuget.md" target="\" />
        <file src="Tlumach.png" target="\" />

        <!-- .NET 9.0 -->
        <file src="src\Tlumach.Scriban\bin\Release\net9.0\Tlumach.Scriban.dll" target="lib\net9.0" />
        <file src="src\Tlumach.Scriban\bin\Release\net9.0\Tlumach.Scriban.xml" target="lib\net9.0" />

        <!-- .NET 10.0 -->
        <file src="src\Tlumach.Scriban\bin\Release\net10.0\Tlumach.Scriban.dll" target="lib\net10.0" />
        <file src="src\Tlumach.Scriban\bin\Release\net10.0\Tlumach.Scriban.xml" target="lib\net10.0" />
    </files>
</package>
