<?xml version="1.0" encoding="utf-8"?>
<!-- The $version$ and $commit$ tokens are set by the build script (nuget pack -Properties "version=...;commit=..."), see build-tlumach-net.cmd -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AlliedBits.Tlumach.Writers</id>
        <version>$version$</version>
        <authors>Allied Bits Ltd., Eugene Mayevski</authors>
        <copyright>Allied Bits Ltd.</copyright>
        <license type="expression">Apache-2.0</license>
        <icon>Tlumach.Writers.png</icon>
        <title>Writer classes for Tlumach, the translation and localization package for .NET</title>
        <tags>tlumach translation localization export conversion json resx xliff arb toml ini csv tsv xcstrings</tags>
        <repository type="git" url="https://github.com/Allied-Bits-Ltd/tlumach-net" commit="$commit$" />
        <projectUrl>https://alliedbits.com/tlumach</projectUrl>
        <readme>README.writers.nuget.md</readme>
        <releaseNotes>https://github.com/Allied-Bits-Ltd/tlumach-net/blob/v$version$/CHANGELOG.md</releaseNotes>
        <description>
            This package contains the writer classes for Tlumach.NET. These classes can be used to export translations and convert them between translation file formats.
        </description>
        <dependencies>
            <!-- The dependency on AlliedBits.Tlumach does not exclude analyzers, so that the generator reaches the projects that reference only this package -->
            <group targetFramework=".NETStandard2.0">
                <dependency id="System.Memory" version="4.6.3"  exclude="Build,Analyzers" />
                <dependency id="System.Text.Json" version="10.0.0" exclude="Build,Analyzers" />
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
            </group>
            <group targetFramework="net9.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
            </group>
            <group targetFramework="net10.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
            </group>
    </dependencies>
    </metadata>
    <files>
        <file src="README.writers.nuget.md" target="\" />
        <file src="Tlumach.Writers.png" target="\" />

        <!-- Assemblies -->

        <!-- .NET Standard 2.0 -->
        <file src="src\Tlumach.Writers\bin\Release\netstandard2.0\Tlumach.Writers.dll" target="lib\netstandard2.0" />

        <!-- .NET 9.0 -->
        <file src="src\Tlumach.Writers\bin\Release\net9.0\Tlumach.Writers.dll" target="lib\net9.0" />


        <!-- .NET 10.0 -->
        <file src="src\Tlumach.Writers\bin\Release\net10.0\Tlumach.Writers.dll" target="lib\net10.0" />


        <!-- XML documentation -->
        <file src="src\Tlumach.Writers\bin\Release\netstandard2.0\Tlumach.Writers.xml" target="lib\netstandard2.0" />
        <file src="src\Tlumach.Writers\bin\Release\net9.0\Tlumach.Writers.xml" target="lib\net9.0" />
        <file src="src\Tlumach.Writers\bin\Release\net10.0\Tlumach.Writers.xml" target="lib\net10.0" />
    </files>
</package>
