<?xml version="1.0" encoding="utf-8"?>
<!-- The $version$ and $commit$ tokens are set by the build script (nuget pack -Properties "version=...;commit=..."), see build-tlumach-net.cmd -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AlliedBits.Tlumach.Syncfusion.Blazor</id>
        <version>$version$</version>
        <authors>Allied Bits Ltd., Eugene Mayevski</authors>
        <copyright>Allied Bits Ltd.</copyright>
        <license type="expression">Apache-2.0</license>
        <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
        <icon>Tlumach.png</icon>
        <title>Syncfusion Blazor integration for Tlumach, the translation and localization package for .NET</title>
        <tags>tlumach translation localization syncfusion blazor</tags>
        <repository type="git" url="https://github.com/Allied-Bits-Ltd/tlumach-net" commit="$commit$" />
        <projectUrl>https://alliedbits.com/tlumach</projectUrl>
        <readme>README.syncfusion.blazor.nuget.md</readme>
        <description>
            This package localizes the texts built into Syncfusion Blazor components (grid pager, filter menus, and search box, date picker, numeric text box, and others) through Tlumach.NET, in the language of each user of a Blazor application, with optional use of the official Syncfusion .resx translations and a fallback to the English texts built into Syncfusion.
        </description>
        <dependencies>
            <group targetFramework="net9.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="AlliedBits.Tlumach.Blazor" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="Syncfusion.Blazor.Core" version="29.1.33" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net10.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="AlliedBits.Tlumach.Blazor" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="Syncfusion.Blazor.Core" version="29.1.33" exclude="Build,Analyzers" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="README.syncfusion.blazor.nuget.md" target="\" />
        <file src="Tlumach.png" target="\" />

        <!-- .NET 9.0 -->
        <file src="src\Tlumach.Syncfusion.Blazor\bin\Release\net9.0\Tlumach.Syncfusion.Blazor.dll" target="lib\net9.0" />
        <file src="src\Tlumach.Syncfusion.Blazor\bin\Release\net9.0\Tlumach.Syncfusion.Blazor.xml" target="lib\net9.0" />

        <!-- .NET 10.0 -->
        <file src="src\Tlumach.Syncfusion.Blazor\bin\Release\net10.0\Tlumach.Syncfusion.Blazor.dll" target="lib\net10.0" />
        <file src="src\Tlumach.Syncfusion.Blazor\bin\Release\net10.0\Tlumach.Syncfusion.Blazor.xml" target="lib\net10.0" />
    </files>
</package>
