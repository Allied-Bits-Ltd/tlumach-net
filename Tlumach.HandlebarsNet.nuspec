<?xml version="1.0" encoding="utf-8"?>
<!-- The $version$ and $commit$ tokens are set by the build script (nuget pack -Properties "version=...;commit=..."), see build-tlumach-net.cmd -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AlliedBits.Tlumach.HandlebarsNet</id>
        <version>$version$</version>
        <authors>Allied Bits Ltd., Eugene Mayevski</authors>
        <copyright>Allied Bits Ltd.</copyright>
        <license type="expression">Apache-2.0</license>
        <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
        <icon>Tlumach.png</icon>
        <title>Handlebars.Net integration for Tlumach, the translation and localization package for .NET</title>
        <tags>tlumach translation localization handlebars template email</tags>
        <repository type="git" url="https://github.com/Allied-Bits-Ltd/tlumach-net" commit="$commit$" />
        <projectUrl>https://alliedbits.com/tlumach</projectUrl>
        <readme>README.handlebarsnet.nuget.md</readme>
        <description>
            This package lets Handlebars.Net templates (emails, reports, documents) use Tlumach.NET translations through the `t` and `t_html` helpers, with named, indexed and ICU placeholder values and a culture per render, so that many cultures can be rendered concurrently.
        </description>
        <dependencies>
            <group targetFramework="net9.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="Handlebars.Net" version="[2.1.0, 3.0.0)" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net10.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="Handlebars.Net" version="[2.1.0, 3.0.0)" exclude="Build,Analyzers" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="README.handlebarsnet.nuget.md" target="\" />
        <file src="Tlumach.png" target="\" />

        <!-- .NET 9.0 -->
        <file src="src\Tlumach.HandlebarsNet\bin\Release\net9.0\Tlumach.HandlebarsNet.dll" target="lib\net9.0" />
        <file src="src\Tlumach.HandlebarsNet\bin\Release\net9.0\Tlumach.HandlebarsNet.xml" target="lib\net9.0" />

        <!-- .NET 10.0 -->
        <file src="src\Tlumach.HandlebarsNet\bin\Release\net10.0\Tlumach.HandlebarsNet.dll" target="lib\net10.0" />
        <file src="src\Tlumach.HandlebarsNet\bin\Release\net10.0\Tlumach.HandlebarsNet.xml" target="lib\net10.0" />
    </files>
</package>
