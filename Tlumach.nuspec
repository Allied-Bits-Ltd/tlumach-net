<?xml version="1.0" encoding="utf-8"?>
<!-- The $version$ and $commit$ tokens are set by the build script (nuget pack -Properties "version=...;commit=..."), see build-tlumach-net.cmd -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AlliedBits.Tlumach</id>
        <version>$version$</version>
        <authors>Allied Bits Ltd., Eugene Mayevski</authors>
        <copyright>Allied Bits Ltd.</copyright>
        <license type="expression">Apache-2.0</license>
        <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
        <icon>Tlumach.png</icon>
        <title>The translation and localization package for .NET</title>
        <tags>tlumach translation localization</tags>
        <repository type="git" url="https://github.com/Allied-Bits-Ltd/tlumach-net" commit="$commit$" />
        <projectUrl>https://alliedbits.com/tlumach</projectUrl>
        <readme>README.nuget.md</readme>
        <description>
        Tlumach.NET is a flexible library that provides translation and localization support to all kinds of .NET applications: from desktop WinForms, UWP, WPF, WinUI, and console to mobile MAUI and Avalonia to server and web applications (including MVC, Razor Pages, and Blazor).
        This is the core package: the translation manager, the parsers of translation files, the code generator, and the localized validation attributes. The integrations with application frameworks are in separate AlliedBits.Tlumach.* packages, which depend on this one.
    </description>
        <dependencies>
            <group targetFramework=".NETStandard2.0">
                <dependency id="NETStandard.Library" version="2.0.3" exclude="Build,Analyzers" />
                <dependency id="System.Memory" version="4.6.3"  exclude="Build,Analyzers" />
                <dependency id="System.Text.Json" version="10.0.0" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net9.0" />
            <group targetFramework="net10.0" />
        </dependencies>
    </metadata>
    <files>
        <file src="README.nuget.md" target="\" />
        <file src="Tlumach.png" target="\" />

        <!-- Generator -->
        <file src="src\Tlumach.Generator\bin\Release\netstandard2.0\Tlumach.Generator.dll" target="analyzers/dotnet" />

        <!-- .NET Standard 2.0 (also used by .NET Framework 4.7.2 and later) -->
        <file src="src\Tlumach.Base\bin\Release\netstandard2.0\Tlumach.Base.dll" target="lib\netstandard2.0" />
        <file src="src\Tlumach.Base\bin\Release\netstandard2.0\Tlumach.Base.xml" target="lib\netstandard2.0" />
        <file src="src\Tlumach\bin\Release\netstandard2.0\Tlumach.dll" target="lib\netstandard2.0" />
        <file src="src\Tlumach\bin\Release\netstandard2.0\Tlumach.xml" target="lib\netstandard2.0" />

        <!-- .NET 9.0 (also used by every platform-specific .NET 9.0 framework) -->
        <file src="src\Tlumach.Base\bin\Release\net9.0\Tlumach.Base.dll" target="lib\net9.0" />
        <file src="src\Tlumach.Base\bin\Release\net9.0\Tlumach.Base.xml" target="lib\net9.0" />
        <file src="src\Tlumach\bin\Release\net9.0\Tlumach.dll" target="lib\net9.0" />
        <file src="src\Tlumach\bin\Release\net9.0\Tlumach.xml" target="lib\net9.0" />
        <file src="src\Tlumach.DataAnnotations\bin\Release\net9.0\Tlumach.DataAnnotations.dll" target="lib\net9.0" />
        <file src="src\Tlumach.DataAnnotations\bin\Release\net9.0\Tlumach.DataAnnotations.xml" target="lib\net9.0" />

        <!-- .NET 10.0 (also used by every platform-specific .NET 10.0 framework) -->
        <file src="src\Tlumach.Base\bin\Release\net10.0\Tlumach.Base.dll" target="lib\net10.0" />
        <file src="src\Tlumach.Base\bin\Release\net10.0\Tlumach.Base.xml" target="lib\net10.0" />
        <file src="src\Tlumach\bin\Release\net10.0\Tlumach.dll" target="lib\net10.0" />
        <file src="src\Tlumach\bin\Release\net10.0\Tlumach.xml" target="lib\net10.0" />
        <file src="src\Tlumach.DataAnnotations\bin\Release\net10.0\Tlumach.DataAnnotations.dll" target="lib\net10.0" />
        <file src="src\Tlumach.DataAnnotations\bin\Release\net10.0\Tlumach.DataAnnotations.xml" target="lib\net10.0" />
    </files>
</package>
