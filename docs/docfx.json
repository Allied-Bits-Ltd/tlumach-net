{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "**.csproj"
          ],
          "src": "../src",
          "exclude": [
            "**/Extension.VisualStudio/**",
            "**/Extension.VSCode/**",
            "**/Tlumach.Generator/**",
            "**/Tlumach.WPF/**",
            "**/Tlumach.UWP/**",
            "**/Tlumach.WinForms/**"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "namespaceLayout":"nested",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    },
    {
      "src": [
        {
          "files": [
            "Tlumach.WPF/Tlumach.WPF.csproj",
            "Tlumach.WinForms/Tlumach.WinForms.csproj"
          ],
          "src": "../src"
        }
      ],
      "dest": "api-windows",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0-windows"
      },
      "namespaceLayout":"flattened",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    },
    {
      "src": [
        {
          "files": [
            "Tlumach.UWP/Tlumach.UWP.csproj"
          ],
          "src": "../src"
        }
      ],
      "dest": "api-uwp",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0-windows10.0.17763.0"
      },
      "namespaceLayout":"flattened",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/*.yml",
          "api-windows/*.yml",
          "api-uwp/*.yml",
          "reference/toc.yml",
          "articles/**/*.md",
          "articles/**/*.yml",
          "index.md",
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "media/**",
          "Tlumach.svg",
          "social-preview.png",
          "favicon.ico"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "api/**.md"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName":"Tlumach",
      "_disableContribution": true,
      "_enableSearch": true,
      "_gitContribute": {
        "branch": "main",
        "apiSpecFolder":"api",
        "repo": "https://github.com/Allied-Bits-ltd/tlumach-net"
      },
      "_gitUrlPattern": "github",
      "_disableSideFilter":true,
      "_appLogoPath": "Tlumach.svg"
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",      
      "modern",
      "tlumach"
    ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "noLangKeyword": false,
    "keepFileLink": true,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}
