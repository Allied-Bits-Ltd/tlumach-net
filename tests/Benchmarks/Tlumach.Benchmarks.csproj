<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>Tlumach.Benchmarks</AssemblyName>
    <RootNamespace>Tlumach.Benchmarks</RootNamespace>

    <!-- BenchmarkDotNet requires a Release build with optimizations enabled. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!--
      Benchmark code intentionally violates a number of analyzer rules (public members without
      docs, instance methods that could be static, deliberately unoptimized reference
      implementations). Analysis is disabled here so the benchmark output stays readable.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisMode>None</AnalysisMode>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS1591;CA1822;CA1707;CA1024;CA5394;SA0001;SA1600;SA1633;S1481;S3903;MA0004;MA0006;MA0011;MA0016;MA0051;RCS1102;RCS1213</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repo-wide analyzer set is not useful for a benchmark harness. -->
    <PackageReference Remove="Microsoft.CodeAnalysis.NetAnalyzers" />
    <PackageReference Remove="Roslynator.Analyzers" />
    <PackageReference Remove="Roslynator.CodeAnalysis.Analyzers" />
    <PackageReference Remove="Roslynator.Formatting.Analyzers" />
    <PackageReference Remove="SonarAnalyzer.CSharp" />
    <PackageReference Remove="StyleCop.Analyzers" />
    <PackageReference Remove="Meziantou.Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tlumach.Base\Tlumach.Base.csproj" />
    <ProjectReference Include="..\..\src\Tlumach\Tlumach.csproj" />
  </ItemGroup>

</Project>
