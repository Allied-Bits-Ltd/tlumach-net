<?xml version="1.0" encoding="utf-8"?>
<!-- The $version$ and $commit$ tokens are set by the build script (nuget pack -Properties "version=...;commit=..."), see build-tlumach-net.cmd -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AlliedBits.Tlumach.UWP</id>
        <version>$version$</version>
        <authors>Allied Bits Ltd., Eugene Mayevski</authors>
        <copyright>Allied Bits Ltd.</copyright>
        <license type="expression">Apache-2.0</license>
        <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
        <icon>Tlumach.png</icon>
        <title>UWP integration for Tlumach, the translation and localization package for .NET</title>
        <tags>tlumach translation localization uwp xaml</tags>
        <repository type="git" url="https://github.com/Allied-Bits-Ltd/tlumach-net" commit="$commit$" />
        <projectUrl>https://alliedbits.com/tlumach</projectUrl>
        <readme>README.uwp.nuget.md</readme>
        <description>
            This package integrates Tlumach.NET with UWP applications on .NET 9 and later: its TranslationUnit class, used by the generated translation classes, is bound to in XAML and updates the UI when the language is switched.
        </description>
        <dependencies>
            <!-- The dependency on AlliedBits.Tlumach does not exclude analyzers, so that the generator reaches the projects that reference only this package -->
            <group targetFramework="net9.0-windows10.0.26100.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
            </group>
            <group targetFramework="net10.0-windows10.0.26100.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="README.uwp.nuget.md" target="\" />
        <file src="Tlumach.png" target="\" />

        <!-- net9.0-windows10.0.26100.0 -->
        <file src="src\Tlumach.UWP\bin\Release\net9.0-windows10.0.26100.0\Tlumach.UWP.dll" target="lib\net9.0-windows10.0.26100.0" />
        <file src="src\Tlumach.UWP\bin\Release\net9.0-windows10.0.26100.0\Tlumach.UWP.xml" target="lib\net9.0-windows10.0.26100.0" />

        <!-- net10.0-windows10.0.26100.0 -->
        <file src="src\Tlumach.UWP\bin\Release\net10.0-windows10.0.26100.0\Tlumach.UWP.dll" target="lib\net10.0-windows10.0.26100.0" />
        <file src="src\Tlumach.UWP\bin\Release\net10.0-windows10.0.26100.0\Tlumach.UWP.xml" target="lib\net10.0-windows10.0.26100.0" />
    </files>
</package>
