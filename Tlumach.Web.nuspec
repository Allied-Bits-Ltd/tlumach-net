<?xml version="1.0" encoding="utf-8"?>
<!-- The $version$ and $commit$ tokens are set by the build script (nuget pack -Properties "version=...;commit=..."), see build-tlumach-net.cmd -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AlliedBits.Tlumach.Web</id>
        <version>$version$</version>
        <authors>Allied Bits Ltd., Eugene Mayevski</authors>
        <copyright>Allied Bits Ltd.</copyright>
        <license type="expression">Apache-2.0</license>
        <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
        <icon>Tlumach.png</icon>
        <title>Shared web support for Tlumach, the translation and localization package for .NET</title>
        <tags>tlumach translation localization web aspnetcore blazor</tags>
        <repository type="git" url="https://github.com/Allied-Bits-Ltd/tlumach-net" commit="$commit$" />
        <projectUrl>https://alliedbits.com/tlumach</projectUrl>
        <readme>README.web.nuget.md</readme>
        <description>
            This package contains the parts of the web integrations of Tlumach.NET that are shared by the Blazor and the ASP.NET Core packages, such as the options of the supported cultures (TlumachCultureOptions, AddTlumachCultures). It does not depend on ASP.NET Core. Applications normally get it as a dependency of AlliedBits.Tlumach.Blazor or AlliedBits.Tlumach.AspNetCore.
        </description>
        <dependencies>
            <!-- The dependency on AlliedBits.Tlumach does not exclude analyzers, so that the generator reaches the projects that reference only this package -->
            <group targetFramework="net9.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.0" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net10.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build" />
                <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.0" exclude="Build,Analyzers" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="README.web.nuget.md" target="\" />
        <file src="Tlumach.png" target="\" />

        <!-- net9.0 -->
        <file src="src\Tlumach.Web\bin\Release\net9.0\Tlumach.Web.dll" target="lib\net9.0" />
        <file src="src\Tlumach.Web\bin\Release\net9.0\Tlumach.Web.xml" target="lib\net9.0" />

        <!-- net10.0 -->
        <file src="src\Tlumach.Web\bin\Release\net10.0\Tlumach.Web.dll" target="lib\net10.0" />
        <file src="src\Tlumach.Web\bin\Release\net10.0\Tlumach.Web.xml" target="lib\net10.0" />
    </files>
</package>
