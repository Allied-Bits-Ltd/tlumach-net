<?xml version="1.0" encoding="utf-8"?>
<!-- The $version$ and $commit$ tokens are set by the build script (nuget pack -Properties "version=...;commit=..."), see build-tlumach-net.cmd -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>AlliedBits.Tlumach.MudBlazor</id>
        <version>$version$</version>
        <authors>Allied Bits Ltd., Eugene Mayevski</authors>
        <copyright>Allied Bits Ltd.</copyright>
        <license type="expression">Apache-2.0</license>
        <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
        <icon>Tlumach.png</icon>
        <title>MudBlazor integration for Tlumach, the translation and localization package for .NET</title>
        <tags>tlumach translation localization mudblazor blazor</tags>
        <repository type="git" url="https://github.com/Allied-Bits-Ltd/tlumach-net" commit="$commit$" />
        <projectUrl>https://alliedbits.com/tlumach</projectUrl>
        <readme>README.mudblazor.nuget.md</readme>
        <description>
            This package localizes the texts built into MudBlazor components (data grid filters and pager, table pager, date picker, dialogs, and others) through Tlumach.NET, in the language of each user of a Blazor application, with a fallback to the English texts built into MudBlazor.
        </description>
        <dependencies>
            <group targetFramework="net9.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="AlliedBits.Tlumach.Blazor" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="MudBlazor" version="[9.0.0, 10.0.0)" exclude="Build,Analyzers" />
            </group>
            <group targetFramework="net10.0">
                <dependency id="AlliedBits.Tlumach" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="AlliedBits.Tlumach.Blazor" version="[$version$]" exclude="Build,Analyzers" />
                <dependency id="MudBlazor" version="[9.0.0, 10.0.0)" exclude="Build,Analyzers" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="README.mudblazor.nuget.md" target="\" />
        <file src="Tlumach.png" target="\" />

        <!-- .NET 9.0 -->
        <file src="src\Tlumach.MudBlazor\bin\Release\net9.0\Tlumach.MudBlazor.dll" target="lib\net9.0" />
        <file src="src\Tlumach.MudBlazor\bin\Release\net9.0\Tlumach.MudBlazor.xml" target="lib\net9.0" />

        <!-- .NET 10.0 -->
        <file src="src\Tlumach.MudBlazor\bin\Release\net10.0\Tlumach.MudBlazor.dll" target="lib\net10.0" />
        <file src="src\Tlumach.MudBlazor\bin\Release\net10.0\Tlumach.MudBlazor.xml" target="lib\net10.0" />
    </files>
</package>
