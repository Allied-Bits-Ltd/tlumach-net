<Project Sdk="Microsoft.NET.Sdk">

    <!-- Not marked IsAotCompatible: Handlebars.Net compiles templates with expression trees and reads models through reflection. -->
    <PropertyGroup>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="../Shared/stylecop.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- The lower bound of the range declared in Tlumach.HandlebarsNet.nuspec, so that the build proves it. -->
        <PackageReference Include="Handlebars.Net" Version="2.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Tlumach.Base\Tlumach.Base.csproj" />
        <ProjectReference Include="..\Tlumach\Tlumach.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Tlumach.TemplateEngineTests" />
    </ItemGroup>

</Project>
