<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The assembly uses no UWP or WinRT types, so it is built without UseUwp (which requires Windows SDK 10.0.26100 or later) and for the oldest Windows version that .NET supports.
         UWP applications that target any later Windows SDK version can use it. -->
    <TargetFrameworks>net9.0-windows10.0.17763.0;net10.0-windows10.0.17763.0</TargetFrameworks>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <DefaultLanguage>en-US</DefaultLanguage>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tlumach.Base\Tlumach.Base.csproj" />
    <ProjectReference Include="..\Tlumach\Tlumach.csproj" />
  </ItemGroup>

</Project>
