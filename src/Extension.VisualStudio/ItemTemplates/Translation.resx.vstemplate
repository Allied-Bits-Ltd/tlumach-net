<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Tlumach Translation File (ResX)</Name>
    <Description>A Tlumach translation file in the ResX format. The file is added to the project as an embedded resource with a duplicate .resx extension and the Non-Resx type, so that the .NET toolchain embeds it verbatim instead of compiling it into a satellite assembly.</Description>
    <Icon>TlumachTemplate.png</Icon>
    <ProjectType>CSharp</ProjectType>
    <DefaultName>Translation.resx.resx</DefaultName>
    <SortOrder>90</SortOrder>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ItemType="EmbeddedResource" ReplaceParameters="true" TargetFileName="$fileinputname$.resx">Translation.resx</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>AlliedBits.Tlumach.Extension.VisualStudio</Assembly>
    <FullClassName>AlliedBits.Tlumach.Extension.VisualStudio.Templates.NonResxItemWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
