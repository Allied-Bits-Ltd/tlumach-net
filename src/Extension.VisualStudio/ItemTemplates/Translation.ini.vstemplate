<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Tlumach Translation File (INI)</Name>
    <Description>A Tlumach translation file in the INI format. The file is added to the project as an embedded resource.</Description>
    <Icon>TlumachTemplate.png</Icon>
    <ProjectType>CSharp</ProjectType>
    <DefaultName>Translation.ini</DefaultName>
    <SortOrder>30</SortOrder>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ItemType="EmbeddedResource" ReplaceParameters="true" TargetFileName="$fileinputname$.ini">Translation.ini</ProjectItem>
  </TemplateContent>
</VSTemplate>
