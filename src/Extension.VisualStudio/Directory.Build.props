<Project>
  <!-- The settings of the repository, including the version, which the extension shares with the library -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    MA0004 (Use ConfigureAwait) is inapplicable for VS extension async code:
    SwitchToMainThreadAsync() does not return a Task, and GetServiceAsync callers
    intentionally stay on the UI thread after the await.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);MA0004</NoWarn>
  </PropertyGroup>
</Project>
