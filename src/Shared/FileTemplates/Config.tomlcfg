# Tlumach configuration file in the TOML format.
# See https://github.com/Allied-Bits-ltd/tlumach-net for the full list of settings.

# The default translation file. This is the only required setting.
defaultFile="$fileinputname$.toml"

# The locale of the default file. Optional, but required for XLIFF, CSV and TSV translations.
defaultLocale="en"

# Settings used by the Tlumach source generator.
generatedNamespace="$rootnamespace$"
generatedClass="Strings"
delayedUnitsCreation="true"

# Locale-specific translation files.
[translations]
# de="$fileinputname$_de.toml"
