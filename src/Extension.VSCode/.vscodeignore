# Exclude TypeScript source — only compiled JS in out/ is needed
src/**

# TypeScript config
tsconfig.json
**/*.ts
**/*.map

# Build-time only — generates templates/ from src/Shared/FileTemplates
scripts/**

# Development files
.vs/**
.vscode/**
.vscode-test/**
node_modules/**

# Tests of the extension
out/test/**

# Runner source — only the published runner (npm run build-runner) is needed
runner/*.cs
runner/*.csproj
runner/Directory.Build.props
runner/obj/**
runner/bin/Debug/**
runner/bin/Release/**
runner/bin/publish/**/*.pdb
runner/bin/publish/**/*.xml
# Assemblies for the browser (WebAssembly), which the runner never uses
runner/bin/publish/runtimes/browser/**

# Misc
.gitignore
*.vsix
