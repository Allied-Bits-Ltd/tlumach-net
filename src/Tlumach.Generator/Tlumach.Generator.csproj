<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- The compiler does not provide System.Text.Json (and on .NET Framework, not all of its dependencies), so the package ships them next to the generator. This puts them to the output folder, from which Tlumach.nuspec takes them. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
      <!-- The shared sources of Tlumach.Base leave out file access and other code that analyzers may not use when GENERATOR is defined, in every configuration and for every platform -->
      <DefineConstants>$(DefineConstants);GENERATOR</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- The oldest compiler that loads the generator is the one of this version: 4.8 comes with the .NET 8 SDK and Visual Studio 2022 17.8. The compiler provides these assemblies, so they are not copied to the output. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework.Contains('netstandard2.0'))">
        <PackageReference Include="System.Memory" Version="4.6.3" />
        <!-- This version is shipped next to the generator (see Tlumach.nuspec); update it deliberately -->
        <PackageReference Include="System.Text.Json" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="../Shared/stylecop.json" />
      <!-- Release tracking of the diagnostics that the generator reports (RS2008) -->
      <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
      <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\Tlumach.Base\ArbParser.cs" Link="ArbParser.cs" />
      <Compile Include="..\Tlumach.Base\BaseGenerator.cs" Link="BaseGenerator.cs" />
      <Compile Include="..\Tlumach.Base\BaseJsonParser.cs" Link="BaseJsonParser.cs" />
      <Compile Include="..\Tlumach.Base\BaseKeyValueParser.cs" Link="BaseKeyValueParser.cs" />
      <Compile Include="..\Tlumach.Base\BaseParser.cs" Link="BaseParser.cs" />
      <Compile Include="..\Tlumach.Base\BaseTableParser.cs" Link="BaseTableParser.cs" />
      <Compile Include="..\Tlumach.Base\BaseTranslationManager.cs" Link="BaseTranslationManager.cs" />
      <Compile Include="..\Tlumach.Base\BaseXMLParser.cs" Link="BaseXMLParser.cs" />
      <Compile Include="..\Tlumach.Base\CsvParser.cs" Link="CsvParser.cs" />
      <Compile Include="..\Tlumach.Base\CultureNameMatchEventArgs.cs" Link="CultureNameMatchEventArgs.cs" />
      <Compile Include="..\Tlumach.Base\Exceptions.cs" Link="Exceptions.cs" />
      <Compile Include="..\Tlumach.Base\FileFormats.cs" Link="FileFormats.cs" />
      <Compile Include="..\Tlumach.Base\HierarchicalKeyComparer.cs" Link="HierarchicalKeyComparer.cs" />
      <Compile Include="..\Tlumach.Base\IcuFragment.cs" Link="IcuFragment.cs" />
      <Compile Include="..\Tlumach.Base\IniParser.cs" Link="IniParser.cs" />
      <Compile Include="..\Tlumach.Base\JsonParser.cs" Link="JsonParser.cs" />
      <Compile Include="..\Tlumach.Base\KeyIndex.cs" Link="KeyIndex.cs" />
      <Compile Include="..\Tlumach.Base\Placeholder.cs" Link="Placeholder.cs" />
      <Compile Include="..\Tlumach.Base\ResxParser.cs" Link="ResxParser.cs" />
      <Compile Include="..\Tlumach.Base\StringCatParser.cs" Link="StringCatParser.cs" />
      <Compile Include="..\Tlumach.Base\TextFormat.cs" Link="TextFormat.cs" />
      <Compile Include="..\Tlumach.Base\TomlParser.cs" Link="TomlParser.cs" />
      <Compile Include="..\Tlumach.Base\Translation.cs" Link="Translation.cs" />
      <Compile Include="..\Tlumach.Base\TranslationConfiguration.cs" Link="TranslationConfiguration.cs" />
      <Compile Include="..\Tlumach.Base\TranslationEntry.cs" Link="TranslationEntry.cs" />
      <Compile Include="..\Tlumach.Base\TranslationTree.cs" Link="TranslationTree.cs" />
      <Compile Include="..\Tlumach.Base\TranslationTreeNode.cs" Link="TranslationTreeNode.cs" />
      <Compile Include="..\Tlumach.Base\TsvParser.cs" Link="TsvParser.cs" />
      <Compile Include="..\Tlumach.Base\Utils.cs" Link="Utils.cs" />
      <Compile Include="..\Tlumach.Base\XliffParser.cs" Link="XliffParser.cs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="Roslynator.Analyzers" Version="4.15.0" />
      <PackageReference Update="Roslynator.CodeAnalysis.Analyzers" Version="4.15.0" />
      <PackageReference Update="Roslynator.Formatting.Analyzers" Version="4.15.0" />
    </ItemGroup>

</Project>
